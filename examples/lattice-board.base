# A minimal base for trying the Lattice board view.
#
# Copy this file into your vault (any folder will do), then open it. The view
# entry below already asks for `lattice-board`; if the plugin is enabled and
# installed, the board renders instead of a table.
#
# A vault with no board of its own gets a blank one written at load (see
# `src/board-seed.ts`). This file is for what that one does not do: keep the
# board to a tagged set of notes, and name the columns up front.
#
# It also expects a folder called `lattice-cards` — see `newItemFolder` below.
# Make the folder before pressing a column's `+`, because a `+` whose folder is
# not there does nothing at all, without an error to say why.
#
# The filter keeps the board to notes tagged `task`. Change or delete it to see
# more of the vault.
#
# `latticeGroupBy` is Lattice's own option key, and the prefix is deliberate:
# `groupBy`, `order`, `filters`, `summaries` and `limit` belong to the core
# Bases plugin, and the Bases syntax reference asks plugin views not to collide
# with core keys.

filters:
  and:
    - file.hasTag("task")

# Where the board puts the notes it creates — the `+` on a column header, and
# the one at the end of a column in the board this is modelled on. It is core
# Bases' own top level key, not a Lattice one, and core reads it in this order:
# this key, then the folder of `newItemTemplate`, then the folder a note is
# derived from, then the vault's own "default location for new notes". So
# without it, a new card lands wherever the vault would put a new note, which
# for most vaults is the root — and the board's notes end up scattered next to
# everything else rather than in the folder the board is about.
#
# It applies to every column, including the one collecting notes with no value:
# the note is made in this folder first, and only then given the column's value.
#
# The folder has to exist. Verified on the machine: point this at a folder that
# is not there and the `+` does nothing — no note, no Notice, no error. Core
# writes the file with `vault.create`, which does not make parents, and the
# write failure is swallowed on the way back up. Nothing Lattice can catch.
newItemFolder: lattice-cards

properties:
  status:
    displayName: Status
  priority:
    displayName: Priority

views:
  - type: lattice-board
    name: Board
    latticeGroupBy: note.status
    latticeShowPropertyNames: true
    # The card shows the note's opening paragraph under its title, clamped to
    # two lines. Bases has no property for a note body, so Lattice reads it
    # itself; set this to false on a board where that line is just noise.
    latticeShowDescription: true
    # The card always renders the file basename as its title, so listing
    # `file.name` here would only print it a second time.
    #
    # What the card shows under the title: the user's own labels, then when the
    # note arrived and when it last moved. The board only draws the properties
    # it deals in — custom properties, formulas, and these two timestamps — so
    # the toolbar's property menu can list a file's path and size without them
    # ever reaching a card. See `src/bases/board-properties.ts`.
    order:
      - note.tags
      - file.ctime
      - file.mtime
